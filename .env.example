# -----------------------------------------------------------------------------
# RAVEL Configuration Template
# Copy this file to .env and supply your credentials:
#   cp .env.example .env
# -----------------------------------------------------------------------------

# --- Graph Engine Configuration ---
# Choose 'tigergraph' for live TigerGraph Cloud cluster, or 'mock' for local verification
RAVEL_GRAPH_ADAPTER=tigergraph

# TigerGraph Savanna / Cloud Cluster Credentials
RAVEL_TG_HOST=https://your-tigergraph-instance.i.tgcloud.io
RAVEL_TG_SECRET=your_tigergraph_restpp_secret
RAVEL_TG_GRAPHNAME=FraudDetectionGraph
RAVEL_TG_USE_TOKEN=true
RAVEL_TG_QUERY_TIMEOUT=30

# --- LLM & Agent Intelligence Provider ---
# Options: 'openai_compatible', 'openai', 'anthropic'
RAVEL_LLM_PROVIDER=openai_compatible
RAVEL_LLM_BASE_URL=https://openrouter.ai/api/v1
RAVEL_LLM_API_KEY=sk-or-v1-your-api-key-here
RAVEL_LLM_MODEL=deepseek/deepseek-v4-flash

# --- Governance & Workflow ---
RAVEL_ENV=production
RAVEL_WORKFLOW_ORCHESTRATOR=langgraph
RAVEL_STATE_DB_URL=sqlite:///data/ravel.db
RAVEL_AUTH_ENABLED=false
RAVEL_ANALYST_API_KEY=ravel-secret-key
